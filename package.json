{
  "name": "azeroth-weekly",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:protocol": "vitest run packages/protocol",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && node scripts/desktop-build.mjs",
    "package:addon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-addon.ps1",
    "smoke": "electron . --smoke-test --data-dir=.cache/smoke"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fengari": "^0.1.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "main": "dist/electron/main.cjs",
  "description": "魔兽世界每周角色计划与进度追踪",
  "author": "Codex",
  "build": {
    "appId": "local.azeroth.weekly",
    "productName": "艾泽拉斯周计划",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**",
      "dist/renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "艾泽拉斯周计划"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
