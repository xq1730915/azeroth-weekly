{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@azeroth-weekly/protocol": [
        "packages/protocol/src/index.ts"
      ],
      "@azeroth-weekly/protocol/fixtures": [
        "packages/protocol/fixtures/sample.ts"
      ]
    },
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
